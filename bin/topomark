#!/usr/bin/env bash
set -euo pipefail
# Self-locating: $CLAUDE_PLUGIN_ROOT is not guaranteed for bin/ executables, so derive from $0.
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# Need Python >= 3.11 for stdlib tomllib (macOS's default python3 can be older).
PY=""
# Each candidate is started to ask, a versioned name too: a pyenv or asdf shim exists for every
# installed version and fails (exit 127) for the ones that are not active.
for c in python3.14 python3.13 python3.12 python3.11 python3; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)' 2>/dev/null; then
    PY="$c"; break
  fi
done
[ -n "$PY" ] || { echo "topomark requires Python >= 3.11 (none found)." >&2; exit 1; }
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
# -P: never put the current directory on sys.path. topomark runs inside repositories it does not
# trust (the plugin hooks run it in whatever repo the agent opened), and a planted tomllib.py or
# json.py there would otherwise be imported in place of the standard library.
exec "$PY" -P -m topomark "$@"
